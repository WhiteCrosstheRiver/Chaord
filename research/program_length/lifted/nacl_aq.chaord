chaord 0.1
dialect core + molecular

system {
  cell 25.465 25.465 25.465
  pbc xyz
  conserve atoms Cl 10 H 1080 Na 10 O 540
}

physics {
  backend classical
  model spce
}

liquid fluid : all {
  molecules Cl- 10
  molecules H2O/spce 540
  molecules Na+ 10
  state density 1.037 g/cm3
  assert cn 3.6 +- 1.1 cutoff 3.10 A
  assert gr_peak 2.85 A height 2.50
}

residual none

provenance {
  dialects "core 0.1.0 + molecular 0.1.0"
  lift_version "0.1.0"
  note "water model spce assumed from r_OH median 1.0000 A (geometry cannot distinguish models sharing this bond length, e.g. TIP3P/TIP4P/TIP4P-2005)"
}
