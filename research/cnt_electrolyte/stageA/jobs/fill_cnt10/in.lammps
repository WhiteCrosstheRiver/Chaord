# LAMMPS input: fill_cnt10  (Stage A / Y6: filling: open CNT in a bulk 1M LiPF6/EC:EMC bath; staged decompression: 50 ps 10 K NVT settle + 100 ps 10->300 K NVT warm-up (fixed volume), then a 5000 -> 1000 -> 100 -> 1 atm stepped NPT descent (650 ps total, Pdamp 25000 fs), then 5 ns NPT 1 atm 300 K; tube starts empty (imbibition))
# Engine: LAMMPS 22 Jul 2025 Update 4. Units: real (A, kcal/mol, fs, V/A).
# Model: pilot model (owner_inputs.md D37 note): OPLS-AA-based rigid
#   molecules from Nutakki 2023 Tables II-III, Werder sp2-C tube carbons,
#   Lorentz-Berthelot mixing (recorded deviation), full +-1 ion charges.
# Thermostat: ONE Langevin scheme for every mobile atom, damping 1 ps:
#   fix rigid/nve molecule langevin (multi-atom bodies) + fix nve +
#   fix langevin (Li+); no Nose-Hoover anywhere (Y6 settings).
#   NOTE rigid/nve (not the /small variant): the local conda build's
#   fix rigid/nve/small molecule corrupted body data at the first
#   integration step for 3 of 4 cnt16 fresh builds (heap-layout
#   dependent; atoms teleported out of the PPPM brick at step 1 with
#   sane step-0 forces/velocities - see stageA_plan.md addendum
#   2026-10-16). Same Langevin scheme, same damping, deterministic
#   body bookkeeping.
# Dumps: every 1 ps, dump_modify format float %.10g, with image flags.
# Thermo: every 1 ps.
#

units           real
atom_style      full
boundary        p p p

read_data       system.data

pair_style      lj/cut/coul/long 12.0
pair_modify     mix arithmetic tail no
kspace_style    pppm 0.0001
pair_coeff      1 1 0.085300 3.4000
pair_coeff      2 2 0.104995 3.7500
pair_coeff      3 3 0.170005 3.0000
pair_coeff      4 4 0.065989 3.5000
pair_coeff      5 5 0.209990 2.9600
pair_coeff      6 6 0.015010 2.4200
pair_coeff      7 7 0.029995 2.5000
pair_coeff      8 8 0.066000 3.5000
pair_coeff      9 9 0.165057 1.5100
pair_coeff      10 10 0.200000 3.7400
pair_coeff      11 11 0.060994 3.1180

bond_style       harmonic
bond_coeff      1 0.0 1.0
special_bonds   lj/coul 0.0 0.0 0.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes exclude molecule/intra all

group           tube type 1
group           mobile subtract all tube
group           li type 9
group           bodies subtract mobile li
fix             frz tube setforce 0.0 0.0 0.0

# honest mobile-subsystem temperature: 2*KE/(DOF*kB), real units
# (the default thermo temp is diluted by the frozen tube atoms)
compute         keb bodies ke
compute         keli li ke
variable        Tmob equal 2.0*(c_keb+c_keli)/(8301*0.0019872041)

timestep        1.0

# smoke self-test:  lmp -var smoke 1 -in in.lammps
variable        smoke index 0
if "${smoke} == 1" then "variable nsettle equal 500" "variable nwarm equal 500" "variable nbaro1 equal 500" "variable nbaro2 equal 500" "variable nbaro3 equal 500" "variable nbaro4 equal 500" "variable nprodf equal 500" &
else "variable nsettle equal 50000" "variable nwarm equal 100000" "variable nbaro1 equal 125000" "variable nbaro2 equal 125000" "variable nbaro3 equal 125000" "variable nbaro4 equal 125000" "variable nprodf equal 5000000"

thermo          1000
thermo_style    custom step atoms v_Tmob temp pe etotal press vol density

velocity        mobile create 10.0 20265100 mom yes rot yes dist gaussian

# force a log/screen flush at every thermo output: these jobs run for
# days; without it the redirected screen.log buffers ~4 KB and shows
# nothing for hours (found while monitoring the 2026-10-20 verification)
thermo_modify    flush yes

# --- stage 1 (50 ps): NVT settle at 10 K, FIXED volume.
#     The packed bath is a cold jam carrying ~+20,000 atm of contact
#     stress (failed-run thermo: P = +20,869 / +11,042 atm at step 0)
#     because pack-then-relax leaves the contact network AT the packing
#     floors (0.85 sigma) even though the density is only ~87% of the
#     CRC target. At fixed volume there is no box degree of freedom to
#     run away: the Langevin bath (1 ps damping) simply drains the
#     contact energy released as neighbouring molecules push apart into
#     local free volume. A Tmob spike like the zf builds' 642 K
#     step-1000 transient is expected and harmless at fixed V.
fix             thb bodies rigid/nve molecule langevin 10 10 1000 5100101
fix             thl li nve
fix             thla li langevin 10 10 1000 5100102
run             ${nsettle}

# --- stage 2 (100 ps): NVT warm-up ramp 10 -> 300 K,
#     still fixed volume. Melt the jam into a normal liquid BEFORE any
#     barostat sees it, so the first pressure the barostat reads is
#     ordinary liquid stress, not jam stress. (The failed runs heated
#     AND barostatted from step 0 - exactly the coupling that ran away.)
unfix           thb
unfix           thl
unfix           thla
fix             thb bodies rigid/nve molecule langevin 10 300 1000 5100201
fix             thl li nve
fix             thla li langevin 10 300 1000 5100202
run             ${nwarm}

# --- stage 3.1: NPT at 300 K, barostat target 5000 atm, held
#     125 ps (stepped decompression 5000 -> 1000 -> 100 -> 1 atm,
#     Pdamp 25000 fs - deliberately ~25x the liquid-typical 1 ps, a
#     very weak barostat: the volume must still grow ~25% to the model's
#     own equation of state, and the 2026-10-19 failure was box-dynamics
#     overshoot at Pdamp 2 ps, so the box is made quasi-static).
#     The 5000 atm head is a conservative UPPER bound on the post-NVT residual pressure, so the barostat's opening action is neutral-to-compressive: it cannot explode by construction.
unfix           thb
unfix           thl
unfix           thla
fix             thb bodies rigid/nve molecule langevin 300 300 1000 5100301
fix             thl li nph iso 5000 5000 25000 dilate mobile
fix             thla li langevin 300 300 1000 5100302
run             ${nbaro1}

# --- stage 3.2: NPT at 300 K, barostat target 1000 atm, held
#     125 ps (stepped decompression 5000 -> 1000 -> 100 -> 1 atm,
#     Pdamp 25000 fs - deliberately ~25x the liquid-typical 1 ps, a
#     very weak barostat: the volume must still grow ~25% to the model's
#     own equation of state, and the 2026-10-19 failure was box-dynamics
#     overshoot at Pdamp 2 ps, so the box is made quasi-static).
#     Each ~5x pressure step keeps the per-stage volume excursion small; the 300 K liquid re-wets the frozen tube between steps (each dilation by dilate mobile opens a thin sleeve at the un-rescaled tube, which the liquid closes again before the next step).
unfix           thb
unfix           thl
unfix           thla
fix             thb bodies rigid/nve molecule langevin 300 300 1000 5100401
fix             thl li nph iso 1000 1000 25000 dilate mobile
fix             thla li langevin 300 300 1000 5100402
run             ${nbaro2}

# --- stage 3.3: NPT at 300 K, barostat target 100 atm, held
#     125 ps (stepped decompression 5000 -> 1000 -> 100 -> 1 atm,
#     Pdamp 25000 fs - deliberately ~25x the liquid-typical 1 ps, a
#     very weak barostat: the volume must still grow ~25% to the model's
#     own equation of state, and the 2026-10-19 failure was box-dynamics
#     overshoot at Pdamp 2 ps, so the box is made quasi-static).
#     Each ~5x pressure step keeps the per-stage volume excursion small; the 300 K liquid re-wets the frozen tube between steps (each dilation by dilate mobile opens a thin sleeve at the un-rescaled tube, which the liquid closes again before the next step).
unfix           thb
unfix           thl
unfix           thla
fix             thb bodies rigid/nve molecule langevin 300 300 1000 5100501
fix             thl li nph iso 100 100 25000 dilate mobile
fix             thla li langevin 300 300 1000 5100502
run             ${nbaro3}

# --- stage 3.4: NPT at 300 K, barostat target 1 atm, held
#     125 ps (stepped decompression 5000 -> 1000 -> 100 -> 1 atm,
#     Pdamp 25000 fs - deliberately ~25x the liquid-typical 1 ps, a
#     very weak barostat: the volume must still grow ~25% to the model's
#     own equation of state, and the 2026-10-19 failure was box-dynamics
#     overshoot at Pdamp 2 ps, so the box is made quasi-static).
#     Each ~5x pressure step keeps the per-stage volume excursion small; the 300 K liquid re-wets the frozen tube between steps (each dilation by dilate mobile opens a thin sleeve at the un-rescaled tube, which the liquid closes again before the next step).
unfix           thb
unfix           thl
unfix           thla
fix             thb bodies rigid/nve molecule langevin 300 300 1000 5100601
fix             thl li nph iso 1 1 25000 dilate mobile
fix             thla li langevin 300 300 1000 5100602
run             ${nbaro4}

# --- stage 4: 5000 ps NPT production (1 atm, 300 K,
#     Pdamp 25000 fs - kept weak so the box keeps drifting
#     adiabatically through the 5 ns), dump every 1 ps
unfix           thb
unfix           thl
unfix           thla
fix             thb bodies rigid/nve molecule langevin 300 300 1000 5100701
fix             thl li nph iso 1 1 25000 dilate mobile
fix             thla li langevin 300 300 1000 5100702
reset_timestep  0
dump            pd all custom 1000 prod.dump id mol type q x y z ix iy iz
dump_modify     pd sort id format float %.10g

run             ${nprodf}

write_data      final.data nocoeff
