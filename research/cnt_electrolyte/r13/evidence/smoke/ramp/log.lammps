# --- ladder protocol starts here (Z3 protocol verbatim):
#     external field along +z switched ON at ladder t = 0 (V/A, real units)
fix             efield mobile efield 0.0 0.0 0.01
# velocities continue from the thermalized state (no re-draw)
fix             thb bodies rigid/nve molecule langevin 300.0 300.0 1000 20292411
207 rigid bodies with 2288 atoms
fix             thl li nve
fix             thla li langevin 300.0 300.0 1000 20292412

