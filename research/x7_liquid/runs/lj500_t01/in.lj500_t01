# lj500_t01: single-species LJ liquid, X7 item 2 liquid floors
# (research/x7_liquid; case lj_liquid, trajectory 1 of 3, new seeds,
# protocol otherwise identical to the committed bench reference)
# params: liq_params.py (cited there); conventions validated bit-exact in
# validate_conventions.py (8/8 vs reports/noise_floors.json)
units           lj
dimension       3
boundary        p p p
atom_style      atomic
read_data       data.lj500_t01

# committed reference potential (bench/reference/lj_liquid/provenance.json):
# LJ 12-6, eps=sigma=m=1, cut 2.5 sigma, energy-shifted at rc (pair_modify
# shift yes), forces truncated.  LAMMPS damp = 1/gamma* = 2.0.
pair_style      lj/cut 2.5
pair_modify     shift yes
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes
timestep        0.005

thermo          1000
thermo_style    custom step temp pe press etotal
thermo_modify   flush yes

# == ASE thermalize(): Maxwell velocities at T*, COM momentum zeroed
velocity        all create 0.72 202611021 mom yes rot no dist gaussian

# ---- equilibration: T*=0.72, 2000 steps (10.0 tau), gamma*=0.5
fix             int all nve
fix             bath all langevin 0.72 0.72 2.0 202611022 zero yes
run             2000
print           "STAGE_END equil T*=$(temp:%.4f) PE=$(pe:%.8f)"

# ---- sampling: 45 frames at 1000-step (5.0 tau) stride
#      (committed protocol.steps.sampling_stride; 45 frames vs 10/5 committed)
run             1000
print           "FRAME 0 PE=$(pe:%.8f)"
write_dump      all custom frame_0.lammpstrj id type x y z modify sort id
run             1000
print           "FRAME 1 PE=$(pe:%.8f)"
write_dump      all custom frame_1.lammpstrj id type x y z modify sort id
run             1000
print           "FRAME 2 PE=$(pe:%.8f)"
write_dump      all custom frame_2.lammpstrj id type x y z modify sort id
run             1000
