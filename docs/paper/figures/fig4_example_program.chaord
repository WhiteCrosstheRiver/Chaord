chaord 0.1
dialect core + lj

system {
  units lj
  cell 9.86 9.86 46.04
  pbc xyz
  state T 0.75
  conserve atoms X 4032
}

physics {
  backend lj
  epsilon 1
  sigma 1
  cutoff 2.5
}

crystal A : slab z 0.2 .. 18.2 {
  lattice fcc
  a 1.644
  orient <100> z <001>
  constrain strain zz -5.1 % +- 0.2
  assert sites_matched 100.0 %
}

liquid B : slab z 18.2 .. 0.2 {  # wraps through z = 0
  state density 0.866
  assert cn 12.2 +- 1.1 cutoff 1.50
  assert gr_peak 1.06 height 3.25
  assert solid_clusters 0
}

interface A | B {
  at z 18.2
  width 1.8
}

interface B | A {
  at z 0.2
  width 1.5
}

residual none

provenance {
  dialects "core 0.1.0 + lj 0.1.0"
  lift_version "0.1.0"
}
